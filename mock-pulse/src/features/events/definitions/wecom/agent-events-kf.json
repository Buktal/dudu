{
  "format": "mockpulse-field-definitions-v1",
  "channelId": "wecom",
  "version": "2026.09",
  "schemas": {
    "wc-kf-msg-or-event": {
      "version": "2026.09",
      "source": "https://developer.work.weixin.qq.com/document/path/94670",
      "fields": [
        {
          "path": "ToUserName",
          "title": "企业 CorpID",
          "type": "string",
          "group": "企业与身份",
          "description": "接收回调的企业 ID（官方样本 ww12345678910 形态），也是加密 receiveid。微信客服回调无 FromUserName、无 AgentID（§5.6）。"
        },
        {
          "path": "CreateTime",
          "title": "事件时间",
          "type": "numberString",
          "group": "会话与时序",
          "description": "10 位 Unix 秒级时间戳。新建时按当前时间生成。"
        },
        {
          "path": "MsgType",
          "title": "消息类型",
          "type": "string",
          "group": "事件内容",
          "description": "事件推送固定为 event。"
        },
        {
          "path": "Event",
          "title": "事件类型",
          "type": "string",
          "group": "事件内容",
          "description": "kf_msg_or_event = 微信客服消息/事件通知（两段式：回调只通知，消息经 sync_msg 拉取）。"
        },
        {
          "path": "Token",
          "title": "拉取凭证",
          "type": "string",
          "group": "会话内容",
          "description": "拉取消息用的临时凭证，10 分钟内有效（官方 §5.6 黄金样本逐字）。"
        },
        {
          "path": "OpenKfId",
          "title": "客服账号 ID",
          "type": "string",
          "group": "会话内容",
          "description": "微信客服账号 ID（官方样本 wk 开头）。"
        }
      ]
    }
  }
}
