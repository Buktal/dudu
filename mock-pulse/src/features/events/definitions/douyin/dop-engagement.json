{
  "format": "mockpulse-field-definitions-v1",
  "channelId": "douyin",
  "version": "2026.09",
  "schemas": {
    "dy-new-video-digg": {
      "version": "2026.09",
      "source": "https://developer.open-douyin.com/docs/resource/zh-CN/dop/develop/webhooks/event-list",
      "fields": [
        {
          "path": "event",
          "title": "事件名称",
          "type": "string",
          "group": "回调信封",
          "description": "平台原始事件名，固定为 new_video_digg。"
        },
        {
          "path": "client_key",
          "title": "应用标识",
          "type": "string",
          "group": "回调信封",
          "description": "使用应用的 client_key。"
        },
        {
          "path": "from_user_id",
          "title": "点赞用户 ID",
          "type": "string",
          "group": "用户与身份",
          "description": "点赞的用户 open_id。",
          "required": true
        },
        {
          "path": "to_user_id",
          "title": "视频作者 ID",
          "type": "string",
          "group": "用户与身份",
          "description": "被点赞视频作者的 open_id。"
        },
        {
          "path": "content.action_type",
          "title": "行为类型",
          "type": "number",
          "group": "事件内容",
          "description": "点赞行为类型，官方样本取值 1。"
        },
        {
          "path": "content.action_time",
          "title": "行为时间",
          "type": "number",
          "group": "事件内容",
          "description": "点赞发生的秒级时间戳。"
        },
        {
          "path": "content.item_id",
          "title": "视频 ID",
          "type": "string",
          "group": "事件内容",
          "description": "被点赞的视频 ID，@ 开头加密串形态（content 为 JSON 字符串内字段）。"
        },
        {
          "path": "log_id",
          "title": "推送日志 ID",
          "type": "string",
          "group": "回调信封",
          "description": "平台推送的追踪标识，重放同一条时可保留原值。"
        }
      ]
    },
