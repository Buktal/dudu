        },
        {
          "path": "content.order_event",
          "title": "订单事件类型",
          "type": "number",
          "group": "订单内容",
          "description": "1=用户支付订单 2=服务商接单 3=服务商确认实施订单 4=用户确认订单 5=取消订单。"
        },
        {
          "path": "content.order_snapshot",
          "title": "订单快照",
          "type": "json",
          "group": "订单内容",
          "description": "订单下单时刻的完整快照（服务 ID、规格、时间等）。"
        },
        {
          "path": "content.purchase_info",
          "title": "购买信息",
