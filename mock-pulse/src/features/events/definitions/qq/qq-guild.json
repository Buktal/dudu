{
  "format": "mockpulse-field-definitions-v1",
  "channelId": "qq",
  "version": "2026.09",
  "schemas": {
    "qq-at-message-create": {
      "version": "2026.09",
      "source": "https://bot.q.qq.com/wiki/develop/api-v2/server-inter/channel/message/event.html",
      "fields": [
        {
          "path": "id",
          "title": "事件 id",
          "type": "string",
          "group": "事件信封",
          "description": "外层事件 id（官方信封样本占位符原文 event_id）。"
        },
        {
          "path": "op",
          "title": "操作码",
          "type": "number",
          "group": "事件信封",
          "description": "固定为 0（Dispatch，事件推送）。"
        },
        {
          "path": "s",
          "title": "下行序列号",
          "type": "number",
          "group": "事件信封",
          "description": "平台下行序列号（官方信封样本值 42）。"
        },
        {
          "path": "t",
          "title": "事件类型",
          "type": "string",
          "group": "事件信封",
          "description": "固定为 AT_MESSAGE_CREATE：文字子频道内 @机器人 或回复机器人消息时推送（公域机器人，PUBLIC_GUILD_MESSAGES 1<<30）。",
          "required": true
        },
        {
          "path": "d.id",
          "title": "消息 id",
          "type": "string",
          "group": "消息内容",
          "description": "频道消息 id（官方样本 0812345677890abcdef）。"
        },
        {
          "path": "d.author.id",
          "title": "作者用户 id",
          "type": "string",
          "group": "消息内容",
          "description": "频道消息作者用户 id（官方样本 1234）。"
        },
        {
          "path": "d.author.username",
          "title": "作者用户名",
          "type": "string",
          "group": "消息内容",
          "description": "官方样本 abc。"
        },
        {
          "path": "d.author.avatar",
          "title": "作者头像",
          "type": "string",
          "group": "消息内容",
          "description": "头像 URL（官方样本 http://thirdqq.qlogo.cn/0）。",
          "format": "url"
        },
        {
          "path": "d.author.bot",
          "title": "是否机器人",
          "type": "boolean",
          "group": "消息内容",
          "description": "作者是否机器人；用户消息固定 false。"
        },
        {
          "path": "d.content",
          "title": "消息内容",
          "type": "string",
          "group": "消息内容",
          "description": "消息文本（官方样本 ndnnd）。",
          "required": true
        },
        {
          "path": "d.channel_id",
          "title": "子频道 id",
          "type": "string",
          "group": "消息内容",
          "description": "文字子频道 id（官方样本 100010）。"
        },
        {
          "path": "d.guild_id",
          "title": "频道 id",
          "type": "string",
          "group": "消息内容",
          "description": "频道 id（官方样本 18700000000001）。"
        },
        {
          "path": "d.member.joined_at",
          "title": "加入频道时刻",
          "type": "string",
          "group": "消息内容",
          "description": "成员加入时刻 RFC3339（官方样本 2021-04-12T16:34:42+08:00）。"
        },
        {
          "path": "d.member.roles",
          "title": "成员角色",
          "type": "json",
          "group": "消息内容",
          "description": "成员角色 id 数组（官方样本 [\"1\"]）。"
        },
        {
          "path": "d.timestamp",
          "title": "消息时刻",
          "type": "string",
          "group": "消息内容",
          "description": "RFC3339 东八区时间（官方样本 2021-05-20T15:14:58+08:00）。"
        },
        {
          "path": "d.seq",
          "title": "消息序号",
          "type": "number",
          "group": "消息内容",
          "description": "Message.seq：频道事件「尽量有序但不保证严格有序」，对顺序有严格需求按它缓冲排序（官方样本 101）。"
        }
      ]
    },
    "qq-direct-message-create": {
      "version": "2026.09",
      "source": "https://bot.q.qq.com/wiki/develop/api-v2/server-inter/channel/message/event.html",
      "fields": [
        {
          "path": "id",
          "title": "事件 id",
          "type": "string",
          "group": "事件信封",
          "description": "外层事件 id（官方信封样本占位符原文 event_id）。"
        },
        {
          "path": "op",
          "title": "操作码",
          "type": "number",
          "group": "事件信封",
          "description": "固定为 0（Dispatch，事件推送）。"
        },
        {
          "path": "s",
          "title": "下行序列号",
          "type": "number",
          "group": "事件信封",
          "description": "平台下行序列号（官方信封样本值 42）。"
        },
        {
          "path": "t",
          "title": "事件类型",
          "type": "string",
          "group": "事件信封",
          "description": "固定为 DIRECT_MESSAGE_CREATE：用户通过频道私信发消息给机器人（DIRECT_MESSAGE 1<<12；私信不支持沙箱环境）。",
          "required": true
        },
        {
          "path": "d.id",
          "title": "消息 id",
          "type": "string",
          "group": "消息内容",
          "description": "私信消息 id（Message 对象同构，形态同频道消息样本）。"
        },
        {
          "path": "d.author.id",
          "title": "作者用户 id",
          "type": "string",
          "group": "消息内容",
          "description": "私信作者用户 id。"
        },
        {
          "path": "d.author.username",
          "title": "作者用户名",
          "type": "string",
          "group": "消息内容",
          "description": "作者用户名。"
        },
        {
          "path": "d.author.avatar",
          "title": "作者头像",
          "type": "string",
          "group": "消息内容",
          "description": "头像 URL。",
          "format": "url"
        },
        {
          "path": "d.author.bot",
          "title": "是否机器人",
          "type": "boolean",
          "group": "消息内容",
          "description": "作者是否机器人；用户消息固定 false。"
        },
        {
          "path": "d.content",
          "title": "消息内容",
          "type": "string",
          "group": "消息内容",
          "description": "私信文本内容。",
          "required": true,
          "multiline": true
        },
        {
          "path": "d.channel_id",
          "title": "私信子频道 id",
          "type": "string",
          "group": "消息内容",
          "description": "私信会话的子频道 id。"
        },
        {
          "path": "d.guild_id",
          "title": "私信频道 id",
          "type": "string",
          "group": "消息内容",
          "description": "私信会话关联的频道 id。"
        },
        {
          "path": "d.member.joined_at",
          "title": "加入频道时刻",
          "type": "string",
          "group": "消息内容",
          "description": "成员加入时刻 RFC3339。"
        },
        {
          "path": "d.member.roles",
          "title": "成员角色",
          "type": "json",
          "group": "消息内容",
          "description": "成员角色 id 数组。"
        },
        {
          "path": "d.timestamp",
          "title": "消息时刻",
          "type": "string",
          "group": "消息内容",
          "description": "RFC3339 东八区时间。"
        },
        {
          "path": "d.seq",
          "title": "消息序号",
          "type": "number",
          "group": "消息内容",
          "description": "Message.seq：按它自行缓冲排序。"
        }
      ]
    }
  }
}
