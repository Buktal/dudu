# Copy to .env. Use distinct random hex passwords (no quotes or spaces).
# Shared by Docker Compose and the Spring dev profile; keep .env out of Git.
MYSQL_PORT=3306
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# DuduServer override. The dev profile already ships a signing key;
# uncomment AND fill a real value to override.
# An uncommented empty value overrides the dev default with a blank one.
# DUDU_AUTH_JWT_SECRET=
