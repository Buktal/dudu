# Copy to .env.local and opt in only when developing with local fixtures.
# The same switch enables mock identity and data in development and packaged builds.
VITE_DESK_MOCK=false

# Optional explicit development scenario; see docs/development.md.
VITE_DESK_SCENARIO=default

# Optional packaged-build API origin (protocol, host and port only).
# Development uses the Vite same-origin /api proxy, so this is not needed locally.
# VITE_API_ORIGIN=https://api.dudu.example
